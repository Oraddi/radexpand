<?xml version="1.0" encoding="utf-8"?>
<!--
  Turkce alt tur: Android 14+ cihazlarda fiziksel klavye duzeni olarak Turkce Q'nun
  otomatik secilmesine yardim eder (Ayarlar > Fiziksel klavye'den degistirilebilir).
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.radexpand.app.MainActivity"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:imeSubtypeLocale="tr_TR"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true"
        android:label="@string/subtype_tr"
        android:languageTag="tr-TR"
        android:physicalKeyboardHintLanguageTag="tr-TR"
        android:physicalKeyboardHintLayoutType="qwerty" />
</input-method>
